<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutGroupes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- En-tête (Header) -->
    <RelativeLayout
        android:id="@+id/layoutHeaderGroupes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:background="#1E3A5F"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/imgHeaderIconGroupes">

            <TextView
                android:id="@+id/txtTitreGroupes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titre_groupes_cmc"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#FF9800" />

            <TextView
                android:id="@+id/txtSubtitleGroupes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/subtitre_groupes_cmc"
                android:textSize="15sp"
                android:textColor="#CBD5E1" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imgHeaderIconGroupes"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_agenda"
            android:contentDescription="@string/titre_groupes_cmc"
            app:tint="#FFFFFF" />

    </RelativeLayout>

    <!-- Contenu principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Ligne des 2 Boutons Adapteurs (Style Tableau de Bord) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="16dp">

            <!-- 1. Bouton ArrayAdapter -->
            <LinearLayout
                android:id="@+id/btnArrayAdapter"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="#E0E7FF"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="#1E3A5F"
                    android:contentDescription="@string/btn_array_adapter" />

                <TextView
                    android:id="@+id/txtBtnArrayAdapter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/btn_array_adapter"
                    android:textColor="#1E3A5F"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Bouton BaseAdapter -->
            <LinearLayout
                android:id="@+id/btnBaseAdapter"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="#DBEAFE"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_manage"
                    app:tint="#1E3A5F"
                    android:contentDescription="@string/btn_base_adapter" />

                <TextView
                    android:id="@+id/txtBtnBaseAdapter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/btn_base_adapter"
                    android:textColor="#1E3A5F"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>



        <!-- Liste des Groupes CMC -->
        <ListView
            android:id="@+id/listGroupesCMC"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="10dp"
            android:scrollbars="vertical" />

    </LinearLayout>

    <!-- Pied de page (Footer) -->
    <TextView
        android:id="@+id/txtFooterGroupes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/footer_dashboard"
        android:textSize="12sp"
        android:textColor="#94A3B8"
        android:gravity="center" />

</LinearLayout>
