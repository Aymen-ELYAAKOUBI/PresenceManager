<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutGroupes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- En-tête (Header) -->
    <RelativeLayout
        android:id="@+id/layoutHeaderGroupes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:background="#1E3A5F"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/imgHeaderIconGroupes">

            <TextView
                android:id="@+id/txtTitreGroupes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titre_groupes_cmc"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#FF9800" />

            <TextView
                android:id="@+id/txtSubtitleGroupes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/subtitre_groupes_cmc"
                android:textSize="15sp"
                android:textColor="#CBD5E1" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imgHeaderIconGroupes"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_agenda"
            android:contentDescription="@string/titre_groupes_cmc"
            app:tint="#FFFFFF" />

    </RelativeLayout>

    <!-- Contenu principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">



        <!-- Ligne 2 : Les 2 Boutons Pill (Activer CAB & Menu Pop-up) -->
        <LinearLayout
            android:id="@+id/layoutActionsGroupes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCabGroupes"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/btn_cab"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="26dp"
                app:backgroundTint="#2563EB" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPopupGroupes"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/btn_popup"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="26dp"
                app:backgroundTint="#0D9488" />
        </LinearLayout>

        <!-- Liste des Groupes CMC -->
        <ListView
            android:id="@+id/listGroupesCMC"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="10dp"
            android:scrollbars="vertical" />

    </LinearLayout>

    <!-- Pied de page (Footer) -->
    <TextView
        android:id="@+id/txtFooterGroupes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/footer_dashboard"
        android:textSize="12sp"
        android:textColor="#94A3B8"
        android:gravity="center" />

</LinearLayout>
