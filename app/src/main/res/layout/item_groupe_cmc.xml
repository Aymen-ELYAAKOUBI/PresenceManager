<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:gravity="center_vertical">

    <!-- Badge Icône du Groupe -->
    <TextView
        android:id="@+id/txtBadgeGroupe"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="#E0E7FF"
        android:gravity="center"
        android:text="DEV"
        android:textColor="#1E3A5F"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Détails du Groupe -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNomGroupe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CMC - DEV101"
            android:textColor="#1E3A5F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtFiliereGroupe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Développement Digital"
            android:textColor="#475569"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtInfoGroupe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="1ère Année • Lab Mobile 1"
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Stagiaires Count Badge -->
    <TextView
        android:id="@+id/txtEffectifGroupe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#DBEAFE"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="28 Stagiaires"
        android:textColor="#1D4ED8"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
